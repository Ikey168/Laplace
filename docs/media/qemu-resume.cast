{"version": 2, "width": 110, "height": 40, "timestamp": 1790279026, "title": "Laplace: pull the power, boot, resume from the IDE disk", "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}}
[0.0, "o", "$ bash scripts/test/qemu_persistence_demo.sh\r\n"]
[0.021007, "o", "==> building the headless IDE-resume harness\r\n"]
[1.735074, "o", "==> power cycle over the durable IDE store\r\n-- boot fresh, count to 5, cut power --\r\n"]
[1.740075, "o", "[boot] resumed counter = 0 (from the IDE store)\r\n"]
[1.740152, "o", "[run ] count = 1 (checkpointed to IDE disk)\r\n"]
[1.740448, "o", "[run ] count = 2 (checkpointed to IDE disk)\r\n"]
[1.740746, "o", "[run ] count = 3 (checkpointed to IDE disk)\r\n"]
[1.741047, "o", "[run ] count = 4 (checkpointed to IDE disk)\r\n"]
[1.741279, "o", "[run ] count = 5 (checkpointed to IDE disk)\r\n"]
[1.741839, "o", "-- reboot: counter must resume at 5 from the IDE store --\r\n"]
[1.744309, "o", "[boot] resumed counter = 5 (want 5)\r\nPASSED: resumed from the durable IDE store\r\n"]
[1.74464, "o", "-- count 5 more, cut power, reboot --\r\n"]
[1.747576, "o", "[boot] resumed counter = 5 (from the IDE store)\r\n"]
[1.747907, "o", "[run ] count = 6 (checkpointed to IDE disk)\r\n"]
[1.74829, "o", "[run ] count = 7 (checkpointed to IDE disk)\r\n"]
[1.748489, "o", "[run ] count = 8 (checkpointed to IDE disk)\r\n"]
[1.748771, "o", "[run ] count = 9 (checkpointed to IDE disk)\r\n"]
[1.749056, "o", "[run ] count = 10 (checkpointed to IDE disk)\r\n"]
[1.751582, "o", "[boot] resumed counter = 10 (want 10)\r\nPASSED: resumed from the durable IDE store\r\n"]
[1.751927, "o", "[ok] headless IDE-store resume gate passed\r\n"]
[1.75244, "o", "==> building the kernel\r\n"]
[5.48156, "o", "[boot 1] fresh disk: counted 20000 .. 360000, then power cut after 3s\r\n"]
[10.173321, "o", "[boot 2] resumed from keyframe 24: counted 380000 .. 940000 (had printed 360000 before the cut), cut after 4s\r\n"]
[13.336259, "o", "[boot 3] resumed from keyframe 56: counted 940000 .. 1300000 (had printed 940000 before the cut), cut after 2.5s\r\n"]
[17.499274, "o", "[boot 4] resumed from keyframe 75: counted 1300000 .. 1780000 (had printed 1300000 before the cut), cut after 3.5s\r\n"]
[17.499506, "o", "PASSED: the booted machine resumed from the IDE disk after every power cut\r\n"]
