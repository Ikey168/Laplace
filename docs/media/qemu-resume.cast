[0.0, "o", "$ bash scripts/test/qemu_persistence_demo.sh\r\n"]
[0.022641, "o", "==> building the headless IDE-resume harness\r\n"]
[1.48489, "o", "==> power cycle over the durable IDE store\r\n-- boot fresh, count to 5, cut power --\r\n"]
[1.488529, "o", "[boot] resumed counter = 0 (from the IDE store)\r\n"]
[1.488665, "o", "[run ] count = 1 (checkpointed to IDE disk)\r\n"]
[1.488906, "o", "[run ] count = 2 (checkpointed to IDE disk)\r\n"]
[1.489099, "o", "[run ] count = 3 (checkpointed to IDE disk)\r\n"]
[1.489311, "o", "[run ] count = 4 (checkpointed to IDE disk)\r\n"]
[1.489459, "o", "[run ] count = 5 (checkpointed to IDE disk)\r\n"]
[1.489901, "o", "-- reboot: counter must resume at 5 from the IDE store --\r\n"]
[1.492834, "o", "[boot] resumed counter = 5 (want 5)\r\nPASSED: resumed from the durable IDE store\r\n"]
[1.493266, "o", "-- count 5 more, cut power, reboot --\r\n"]
[1.495734, "o", "[boot] resumed counter = 5 (from the IDE store)\r\n"]
[1.496088, "o", "[run ] count = 6 (checkpointed to IDE disk)\r\n"]
[1.496374, "o", "[run ] count = 7 (checkpointed to IDE disk)\r\n"]
[1.496629, "o", "[run ] count = 8 (checkpointed to IDE disk)\r\n"]
[1.496918, "o", "[run ] count = 9 (checkpointed to IDE disk)\r\n"]
[1.497209, "o", "[run ] count = 10 (checkpointed to IDE disk)\r\n"]
[1.499581, "o", "[boot] resumed counter = 10 (want 10)\r\nPASSED: resumed from the durable IDE store\r\n"]
[1.500015, "o", "[ok] headless IDE-store resume gate passed\r\n"]
[1.501018, "o", "==> building the kernel\r\n"]
[5.215799, "o", "[boot 1] fresh disk: counted 20000 .. 420000, then power cut after 3s\r\n"]
[9.877309, "o", "[boot 2] resumed from keyframe 24: counted 420000 .. 980000 (had printed 420000 before the cut), cut after 4s\r\n"]
[9.877409, "o", "         lost at most 20000 counts to the cut (work since the newest keyframe)\r\n"]
[13.042915, "o", "[boot 3] resumed from keyframe 56: counted 980000 .. 1320000 (had printed 980000 before the cut), cut after 2.5s\r\n"]
[13.043012, "o", "         lost at most 20000 counts to the cut (work since the newest keyframe)\r\n"]
[17.21258, "o", "[boot 4] resumed from keyframe 75: counted 1320000 .. 1820000 (had printed 1320000 before the cut), cut after 3.5s\r\n"]
[17.212707, "o", "         lost at most 20000 counts to the cut (work since the newest keyframe)\r\n"]
[17.212908, "o", "PASSED: the booted machine resumed from the IDE disk after every power cut\r\n"]
